# 复制为 .env，填写 JWT_SECRET 后启动；不要提交真实密钥。
HTTP_ADDR=127.0.0.1:8081

# 本地 MySQL，与 Compose 的默认开发配置一致。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=video_share
MYSQL_PASSWORD=video_share
MYSQL_DB=video_share
# 仅用于本地 Compose 初始化与隔离测试库；公开部署必须改成独立强口令。
MYSQL_ROOT_PASSWORD=root
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=25
MYSQL_CONN_MAX_LIFETIME_SECONDS=300

# 必填：使用 openssl rand -base64 32 生成随机值。
JWT_SECRET=
JWT_ISSUER=video-share
# Access JWT is intentionally short-lived; refresh state lives in an HttpOnly cookie.
JWT_TTL_SECONDS=900
APP_ORIGIN=http://127.0.0.1:5173
# Set true only behind HTTPS; local HTTP development must explicitly keep this false.
COOKIE_SECURE=false
SESSION_FAMILY_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_CONFLICT_WINDOW_SECONDS=10
# 仅当前面确实有反向代理时填写（逗号分隔的 IP/CIDR）。留空表示不信任任何代理头，
# 避免客户端伪造 X-Forwarded-For 绕过按 IP 的限流。
TRUSTED_PROXIES=
RATE_LIMIT_PER_SECOND=5
RATE_LIMIT_BURST=10

# Redis：Compose 内部会将 REDIS_ADDR 覆盖为 redis:6379；宿主机运行 API 时使用 127.0.0.1:6379。
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT_MS=3000
REDIS_READ_TIMEOUT_MS=2000
REDIS_WRITE_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000

# 分布式限流默认值：登录 10 次/分钟，注册 5 次/10 分钟，评论 10 次/分钟，举报 5 次/10 分钟。
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=600
COMMENT_RATE_LIMIT=10
COMMENT_RATE_WINDOW_SECONDS=60
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_SECONDS=600

# 内部 endpoint 供服务端访问，public endpoint 会写入返回给浏览器的签名 URL；均不含协议或路径。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-share
MINIO_USE_SSL=false
MINIO_CORS_ALLOW_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
UPLOAD_EXPIRY_SECONDS=600
PLAY_EXPIRY_SECONDS=3600
MAX_VIDEO_BYTES=524288000

# Kafka 与异步转码。
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TRANSCODE_TOPIC=video.transcode.requested
KAFKA_CONSUMER_GROUP=video-transcoder-v1
KAFKA_CLIENT_ID=video-share
KAFKA_PUBLISH_TIMEOUT_MS=5000
TRANSCODE_MAX_ATTEMPTS=3
TRANSCODE_RETRY_BASE_SECONDS=5
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_ID=local-worker-1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODE_TEMP_DIR=.tmp/transcode
TRANSCODE_TIMEOUT_SECONDS=1800

# 集成测试：需要 `-tags integration` 才会运行；普通本地模式未设置依赖时相关用例会 skip，
# REQUIRE_INTEGRATION_TESTS=true 时缺少关键依赖或连接失败会直接失败。
# TEST_MYSQL_DSN 必须指向**一次性测试库**：internal/testutil 会自建临时库并在结束时删除，
# 不要把它指向业务库。示例中的主机/端口仅示意，口令请用占位符替换。
TEST_MYSQL_DSN=root:CHANGE_ME@tcp(127.0.0.1:3308)/mysql?parseTime=true&charset=utf8mb4
TEST_KAFKA_BROKERS=127.0.0.1:9092
TEST_REDIS_ADDR=127.0.0.1:6379
TEST_REDIS_PASSWORD=
# Dedicated Redis DB for integration tests; do not point this at a business DB.
TEST_REDIS_DB=15
# Isolated storage bucket is created and deleted by the integration test.
TEST_MINIO_ENDPOINT=127.0.0.1:9000
TEST_MINIO_ACCESS_KEY=minioadmin
TEST_MINIO_SECRET_KEY=minioadmin
TEST_FFMPEG_PATH=ffmpeg
TEST_FFPROBE_PATH=ffprobe
# Set true in CI/release gates to fail instead of silently skipping missing
# integration dependencies. Ordinary local runs may leave it false.
REQUIRE_INTEGRATION_TESTS=false
