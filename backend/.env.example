# 复制为 .env，填写 JWT_SECRET 后启动；不要提交真实密钥。
HTTP_ADDR=127.0.0.1:8081

# 本地 MySQL，与 Compose 的默认开发配置一致。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=video_share
MYSQL_PASSWORD=video_share
MYSQL_DB=video_share
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=25
MYSQL_CONN_MAX_LIFETIME_SECONDS=300

# 必填：使用 openssl rand -base64 32 生成随机值。
JWT_SECRET=
JWT_ISSUER=video-share
JWT_TTL_SECONDS=86400
TRUSTED_PROXIES=
RATE_LIMIT_PER_SECOND=5
RATE_LIMIT_BURST=10

# 内部 endpoint 供服务端访问，public endpoint 会写入返回给浏览器的签名 URL；均不含协议或路径。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-share
MINIO_USE_SSL=false
MINIO_CORS_ALLOW_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
UPLOAD_EXPIRY_SECONDS=600
PLAY_EXPIRY_SECONDS=3600
MAX_VIDEO_BYTES=524288000

# Kafka 与异步转码。
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TRANSCODE_TOPIC=video.transcode.requested
KAFKA_CONSUMER_GROUP=video-transcoder-v1
KAFKA_CLIENT_ID=video-share
TRANSCODE_MAX_ATTEMPTS=3
TRANSCODE_RETRY_BASE_SECONDS=5
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_ID=local-worker-1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODE_TEMP_DIR=.tmp/transcode
TRANSCODE_TIMEOUT_SECONDS=1800
